model Usuario {
  id_usuario Int     @id @default(autoincrement())
  login      String  @db.VarChar(11)    @unique
  email      String  @db.VarChar(320)   @unique
  senha_hash String  @db.VarChar(150)
  funcao     String? @db.VarChar(30)

  // Relacionamentos inversos necessários pelo Prisma
  pacientes       Paciente[]
  avaliacoesLocal LocalAvaliacao[]
  profissionais   Profissional[]

  @@map("usuarios")
}